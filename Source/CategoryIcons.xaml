<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monochrome category artwork: 20 DIP canvas and the same fine, rounded
         contour used by the surrounding Segoe Fluent category glyphs. -->
    <SolidColorBrush x:Key="CategoryIcon.Stroke" Color="#FFFFFF"/>
    <Pen x:Key="CategoryIcon.Pen" Brush="{StaticResource CategoryIcon.Stroke}"
         Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>

    <!-- ScreenXpert: the two offset diagonal ribbon shapes of its application mark. -->
    <DrawingImage x:Key="Icon.ScreenXpert">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 20 V 20 H 0 Z"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 5.2,11.35 C 4.25,10.4 4.25,8.95 5.2,8 L 11.3,1.9 L 16.3,1.9 L 8.55,9.65 C 7.62,10.58 6.15,12.3 5.2,11.35 Z"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 14.8,8.65 C 15.75,9.6 15.75,11.05 14.8,12 L 8.7,18.1 L 3.7,18.1 L 11.45,10.35 C 12.38,9.42 13.85,7.7 14.8,8.65 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Wallpaper Engine: two open, offset frames flow into opposing gear halves. -->
    <DrawingImage x:Key="Icon.WallpaperEngine">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 20 V 20 H 0 Z"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 5.9,3.7 C 5.9,2.65 6.75,1.8 7.8,1.8 H 16.4 C 17.5,1.8 18.3,2.65 18.3,3.7 V 12.5 C 18.3,13.55 17.5,14.4 16.4,14.4 H 11.25 V 15.75 H 9.25 V 14.35 C 8.55,14.2 7.9,13.9 7.35,13.45 L 6.4,14.4 L 5.05,13.05 L 6,12.1 C 5.65,11.6 5.4,10.95 5.3,10.4 H 4.05 V 8.45 H 5.4 C 5.6,7.8 5.9,7.35 6.3,6.9"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 14.45,16.25 C 14.45,17.3 13.6,18.15 12.55,18.15 H 3.7 C 2.6,18.15 1.75,17.3 1.75,16.2 V 7.35 C 1.75,6.25 2.6,5.4 3.7,5.4 H 9.25 V 4.05 H 11.25 V 5.45 C 11.95,5.6 12.6,5.9 13.15,6.35 L 14.1,5.4 L 15.45,6.75 L 14.5,7.7 C 14.85,8.2 15.1,8.85 15.2,9.4 H 16.45 V 11.35 H 15.1 C 14.9,12 14.6,12.45 14.2,12.9"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="10.25,9.9" RadiusX="1.85" RadiusY="1.85"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ARMOURY CRATE: the hexagonal crate and three faceted triangular blades. -->
    <DrawingImage x:Key="Icon.ArmouryCrate">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 20 V 20 H 0 Z"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 10,1.15 L 18,5.55 V 14.45 L 10,18.85 L 2,14.45 V 5.55 Z"/>
                <GeometryDrawing Pen="{StaticResource CategoryIcon.Pen}"
                    Geometry="M 10,2.55 L 16.55,13.95 L 12.65,11.65 Z M 16.55,13.95 L 3.45,13.95 L 7.45,11.65 Z M 3.45,13.95 L 10,2.55 L 10,7.2 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
