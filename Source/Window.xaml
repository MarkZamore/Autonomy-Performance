<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autonomy&amp;Performance"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowBackdrop}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource Font.Family}"
        FontSize="{StaticResource Font.Body}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="{StaticResource Pad.Canvas}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="0" Style="{StaticResource SettingsScrollViewer}" Margin="{StaticResource Gap.SettingsScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue" AutomationProperties.Name="Настройки скрипта">
                <StackPanel>
                    <Expander x:Name="PowerSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Режим питания Windows">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.Power}"/><TextBlock Grid.Column="1" Text="Режим питания Windows" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="EnergySaverSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Энергосбережение"/></CheckBox>
                            <CheckBox x:Name="Efficiency"><TextBlock Text="Максимальная эффективность энергосбережения"/></CheckBox>
                            <CheckBox x:Name="Balanced"><TextBlock Text="Сбалансированный"/></CheckBox>
                            <CheckBox x:Name="BestPerformance"><TextBlock Text="Оптимальная производительность"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DisplaySection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Дисплей">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.Display}"/><TextBlock Grid.Column="1" Text="Дисплей" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <ComboBox x:Name="DisplaySelector" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Экран"/>
                            <ComboBox x:Name="ScaleSelector" Margin="{StaticResource Gap.Row}" IsEnabled="False" AutomationProperties.Name="Масштаб дисплея"/>
                            <ComboBox x:Name="ResolutionSelector" Margin="{StaticResource Gap.Row}" IsEnabled="False" AutomationProperties.Name="Разрешение экрана"/>
                            <ComboBox x:Name="RefreshSelector" IsEnabled="False" AutomationProperties.Name="Частота обновления"/>
                            <CheckBox x:Name="HdrSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="HDR"/></CheckBox>
                            <CheckBox x:Name="DynamicRefreshSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Динамическая частота обновления"/></CheckBox>
                            <TextBlock x:Name="DisplayUnavailable" Text="Доступные дисплеи не найдены" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="{StaticResource Gap.Subtitle}"/>
                            <CheckBox x:Name="BrightnessToggleButton" Style="{StaticResource BinaryActionSwitch}" AutomationProperties.Name="Яркость">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Яркость" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource BrightnessSlider}" Minimum="0" Maximum="100" Value="100" IsEnabled="False" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" MinWidth="55" AutomationProperties.Name="Яркость, в процентах"/>
                                </Grid>
                            </CheckBox>
                            <ComboBox x:Name="ContentBrightnessSelector" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Изменять яркость с учётом содержимого"/>
                            <CheckBox x:Name="NightLightSwitch" Style="{StaticResource TriStateSwitch}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ночной свет" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider x:Name="NightLightSlider" Grid.Column="1" Style="{StaticResource BrightnessSlider}" Minimum="0" Maximum="100" Value="50" IsEnabled="False" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" MinWidth="55" AutomationProperties.Name="Интенсивность ночного света"/>
                                </Grid>
                            </CheckBox>
                            <CheckBox x:Name="AdaptiveBrightnessSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Автоматически менять яркость при изменении освещения"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="AdditionalSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Дополнительно">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.Additional}"/><TextBlock Grid.Column="1" Text="Дополнительно" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="DarkThemeSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Тёмная тема Windows"/></CheckBox>
                            <CheckBox x:Name="ScreenSaverSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Заставка"/></CheckBox>
                            <CheckBox x:Name="UsbPowerSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Останавливать USB-устройства, когда экран выключен, для экономии заряда батареи"/></CheckBox>
                            <CheckBox x:Name="PresenceSleepSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Отключать экран, когда я ухожу"/></CheckBox>
                            <CheckBox x:Name="PresenceWakeSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Пробуждать мое устройство, когда я приближаюсь"/></CheckBox>
                            <CheckBox x:Name="PresenceDimSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Автоматически уменьшать яркость, когда я отвожу взгляд"/></CheckBox>
                            <CheckBox x:Name="PresenceOnlookerSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Обнаружить, когда другие люди смотрят на мой экран"/></CheckBox>
                            <CheckBox x:Name="BatteryPercentageSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Процент заряда батареи на панели задач"/></CheckBox>
                            <CheckBox x:Name="ClockSecondsSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Секунды в часах на панели задач"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="ArmourySection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Armoury Crate">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="ArmouryCrateIcon" Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.ArmouryCrate}"/><TextBlock Grid.Column="1" Text="Armoury Crate" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <Grid/>
                    </Expander>
                    <Expander x:Name="PerformanceSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="ScreenXpert">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="ScreenXpertIcon" Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.ScreenXpert}"/><TextBlock Grid.Column="1" Text="ScreenXpert" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <ComboBox x:Name="FanModeSelector" AutomationProperties.Name="Режим вентилятора"/>
                            <CheckBox x:Name="BatteryCareSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Режим бережной зарядки"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="WallpaperSection" AutomationProperties.Name="Wallpaper Engine">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="WallpaperEngineIcon" Style="{StaticResource AppCategoryIcon}" Source="{StaticResource Icon.WallpaperEngine}"/><TextBlock Grid.Column="1" Text="Wallpaper Engine" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="WallpaperApplicationSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Wallpaper Engine"/></CheckBox>
                            <CheckBox x:Name="WallpaperPlaybackSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Воспроизведение обоев"/></CheckBox>
                            <CheckBox x:Name="WallpaperAudioSwitch" Style="{StaticResource TriStateSwitch}"><TextBlock Text="Звук обоев"/></CheckBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="PreviewHeader" Height="32" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Viewbox x:Name="PreviewHeaderTitleHost" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewHeaderTitle" Text="Предпросмотр скрипта" Style="{StaticResource Heading}" TextWrapping="NoWrap"/>
                        </Viewbox>
                        <Button x:Name="ResetScriptButton" Grid.Column="1" Style="{StaticResource IconActionButton}" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Сбросить настройки скрипта"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="16" TextWrapping="NoWrap"/></Button>
                    </Grid>
                    <ScrollViewer x:Name="ScriptPreview" Grid.Row="1" Margin="{StaticResource Pad.Preview}" Style="{StaticResource SettingsScrollViewer}" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Предпросмотр скрипта">
                        <Grid>
                            <TextBlock x:Name="PreviewEmpty" Text="" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <ItemsControl x:Name="PreviewActions" Visibility="Collapsed" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </Grid>
                    </ScrollViewer>
                    <CheckBox x:Name="AddToStartMenu" Grid.Row="2" Content="Добавить в меню Пуск" IsChecked="True" MinHeight="32" Margin="0,12,0,0" ToolTip="Создать ярлык .lnk в папке меню «Пуск» текущего пользователя"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource Gap.Footer}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Brush.TextMuted}" Margin="{StaticResource Gap.Status}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="PresetAutonomyButton" Content="Автономность" Margin="{StaticResource Gap.Icon}"/>
                    <Button x:Name="PresetPerformanceButton" Content="Производительность" Margin="{StaticResource Gap.Icon}"/>
                    <TextBlock x:Name="BatteryWear" Style="{StaticResource Caption}" Margin="4,4,0,4" VerticalAlignment="Center" TextWrapping="Wrap" Text="Износ батареи: нет данных"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="IconButton" Width="{Binding ActualHeight, ElementName=SaveButton}" Height="{Binding ActualHeight, ElementName=SaveButton}" Margin="{StaticResource Gap.Icon}" Padding="4" ToolTip="Выбрать иконку" AutomationProperties.Name="Выбрать иконку"><Image x:Name="CurrentIcon" Width="24" Height="24"/></Button>
                    <Button x:Name="SaveButton" IsEnabled="False" Content="Сохранить" ToolTip="Сохранить автономный EXE для выполнения скрипта" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
                <Popup x:Name="IconPopup" PlacementTarget="{Binding ElementName=IconButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                    <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Popup}">
                        <UniformGrid x:Name="IconGrid" Rows="2" Columns="3" Width="{StaticResource Size.PopupWidth}" KeyboardNavigation.TabNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>
