<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автономность и производительность"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowBackdrop}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource Font.Family}"
        FontSize="{StaticResource Font.Body}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="{StaticResource Pad.Canvas}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="0" Style="{StaticResource SettingsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Continue" AutomationProperties.Name="Настройки скрипта">
                <StackPanel>
                    <Expander x:Name="AutonomySection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Автономность">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CategoryIcon}" Text="&#xEBA0;"/><TextBlock Grid.Column="1" Text="Автономность" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="SaverOn"><TextBlock Text="Включить энергосбережение"/></CheckBox>
                            <CheckBox x:Name="Whisper"><TextBlock Text="Тихий режим вентиляторов"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PerformanceSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Производительность">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CategoryIcon}" Text="&#xEC4A;"/><TextBlock Grid.Column="1" Text="Производительность" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="SaverOff"><TextBlock Text="Выключить энергосбережение"/></CheckBox>
                            <CheckBox x:Name="FanPerformance"><TextBlock Text="Производительный режим вентиляторов"/></CheckBox>
                            <CheckBox x:Name="Brightness"><TextBlock Text="Яркость 100%"/></CheckBox>
                            <CheckBox x:Name="Volume"><TextBlock Text="Громкость 100%"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PowerSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Режим питания Windows">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CategoryIcon}" Text="&#xE7E8;"/><TextBlock Grid.Column="1" Text="Режим питания Windows" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="Efficiency"><TextBlock Text="Максимальная эффективность энергосбережения"/></CheckBox>
                            <CheckBox x:Name="Balanced"><TextBlock Text="Сбалансированный"/></CheckBox>
                            <CheckBox x:Name="BestPerformance"><TextBlock Text="Оптимальная производительность"/></CheckBox>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="DisplaySection" AutomationProperties.Name="Дисплей">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CategoryIcon}" Text="&#xE7F4;"/><TextBlock Grid.Column="1" Text="Дисплей" VerticalAlignment="Center"/></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="DisplayEnabled"><TextBlock Text="Изменить частоту обновления"/></CheckBox>
                            <TextBlock Text="Экран" Style="{StaticResource Caption}" Margin="{StaticResource Gap.FieldLabel}"/>
                            <ComboBox x:Name="DisplaySelector" Margin="{StaticResource Gap.Row}" IsEnabled="False" AutomationProperties.Name="Экран"/>
                            <TextBlock Text="Частота обновления" Style="{StaticResource Caption}" Margin="{StaticResource Gap.FieldLabel}"/>
                            <ComboBox x:Name="RefreshSelector" IsEnabled="False" AutomationProperties.Name="Частота обновления"/>
                            <TextBlock x:Name="DisplayUnavailable" Text="Доступные дисплеи не найдены" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="{StaticResource Gap.Subtitle}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Предпросмотр скрипта" Style="{StaticResource Heading}"/>
                    <TextBox x:Name="ScriptPreview" Grid.Row="1" Margin="{StaticResource Pad.Preview}" Style="{StaticResource PreviewTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Предпросмотр скрипта"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource Gap.Footer}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="Status" Foreground="{DynamicResource Brush.TextMuted}" Margin="{StaticResource Gap.Status}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PresetPerformanceButton" Content="Производительность" Margin="{StaticResource Gap.Icon}" ToolTip="Заменить действия пресетом производительности"/>
                    <Button x:Name="PresetAutonomyButton" Content="Автономность" ToolTip="Заменить действия пресетом автономности"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="IconButton" Width="{StaticResource Size.IconButton}" Margin="{StaticResource Gap.Icon}" Padding="4" ToolTip="Выбрать иконку" AutomationProperties.Name="Выбрать иконку"><Image x:Name="CurrentIcon" Width="24" Height="24"/></Button>
                    <Button x:Name="SaveButton" Width="{StaticResource Size.SaveWidth}" Style="{StaticResource PrimaryButton}" IsEnabled="False" Content="Сохранить"/>
                </StackPanel>
                <Popup x:Name="IconPopup" PlacementTarget="{Binding ElementName=IconButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                    <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Popup}">
                        <UniformGrid x:Name="IconGrid" Rows="2" Columns="3" Width="{StaticResource Size.PopupWidth}" KeyboardNavigation.TabNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>
